# Copy to .env.e2e (git-ignored). Shell environment variables take precedence.
# Defaults apply only to a local stack created by `npm run stack:up`.
BASE_URL=http://localhost:3001
# API_URL=http://localhost:3001/api

SUPER_ADMIN_EMAIL=superadmin@cliq.test
SUPER_ADMIN_PASSWORD=

# Direct connection to the stack's Postgres, used to refresh materialized views.
# Defaults to the local stack; leave unset for a remote BASE_URL to skip those tests.
# DB_URL=postgres://cliq:cliq@localhost:55432/cliq
