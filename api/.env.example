PORT=3000
DB_URL='postgres://db-username:db-password@your-db-host:5432/db-name'
DB_SCHEMA='public'
# Optional: enable TLS for the Postgres connection (needed for most managed Postgres, e.g. RDS/Aurora)
DB_SSL=
# Optional: verify the server certificate against Node's trusted CAs (defaults to false,
# since Node doesn't trust Amazon's RDS CA out of the box)
DB_SSL_REJECT_UNAUTHORIZED=
REDIS_PORT=6379
JWT_SECRET='your-secret'
JWT_EXPIRES_IN='some duration eg- 30d'
SALT_ROUNDS=2
REDIS_HOST=your-redis-host