  "keyFeatures": [
    "Self-hosted deployment via Docker Compose with PostgreSQL and Redis",
    "Multi-tenant referral program management with role-based access control",
    "Referral tracking across signups, purchases, and commissions",
    "Real-time webhook events following the CloudEvents specification",
    "Promoter portal (Angular frontend) for promoter self-service",
    "Circles for grouping promoters into segments",
    "Commission functions with configurable conversion logic",
    "Detailed analytics and CSV reporting for programs and promoters",
    "Dual authentication: JWT Bearer tokens and API key/secret pairs",
    "REST API built on NestJS with OpenAPI/Swagger documentation"
  ],
  "publicApiSurface": [
    "POST /programs — Create program",
    "GET /programs — List programs",
    "GET /programs/:program_id — Get program",
