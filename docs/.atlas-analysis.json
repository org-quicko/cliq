    "GET /programs/:program_id/commissions — Program commissions",
    "GET /programs/:program_id/referrals — Program referrals",
    "GET /programs/:program_id/report — Program commission report (CSV)",
    "POST /programs/:program_id/promoters — Create promoter",
    "GET /programs/:program_id/promoters — List promoters",
    "GET /programs/:program_id/promoters/:promoter_id — Get promoter",
    "PATCH /programs/:program_id/promoters/:promoter_id — Update promoter",
    "DELETE /programs/:program_id/promoters/:promoter_id — Delete promoter",
    "GET /programs/:program_id/promoters/:promoter_id/analytics — Promoter analytics",
    "POST /programs/:program_id/circles — Create circle",
    "GET /programs/:program_id/circles — List circles",
    "POST /programs/:program_id/functions — Create commission function",
    "POST /programs/:program_id/webhooks — Create webhook",
